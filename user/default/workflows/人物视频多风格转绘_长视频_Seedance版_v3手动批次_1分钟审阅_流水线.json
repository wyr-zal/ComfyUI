e 2.0 Fast","gpt-5.6-terra","gpt-image-2","low",0.85,2,true,false,false,"WisArt","只换脸，亚洲面孔残留，本土东方造型，中式古装，中式建筑，中式家具，中文招牌，本土化道路设施，原人物残留，原服装残留，原背景残留，轻微调色，少量道具替换，地域混乱，媒介变化，风格漂移，人物复制，身份变化，多余人物，肢体畸形，额外手指，背景跳变，字幕，文字，Logo，水印","欧美化资源",true,false,""],"color":"#234","bgcolor":"#345"},{"id":5,"type":"CompanyLongVideoPipelineAssetVideoGenerator","pos":[2480,0],"size":[720,700],"flags":{},"order":4,"mode":0,"inputs":[{"localized_name":"job","name":"job","type":"长视频分段任务","link":4},{"localized_name":"image_concurrency","name":"image_concurrency","type":"INT","widget":{"name":"image_concurrency"},"link":null}],"outputs":[{"localized_name":"已生成当前批次任务","name":"已生成当前批次任务","type":"长视频分段任务","links":[14]},{"localized_name":"流水线状态 JSON","name":"流水线状态 JSON","type":"STRING","links":[]}],"title":"5. 实时预览整帧转绘，筛选后生成 Seedance","properties":{"Node name for S&R":"CompanyLongVideoPipelineAssetVideoGenerator","last_auto_asset_progress":{"job_id":"c8f83c18e43c6aac52f8","percent":100,"value":0,"total":1,"phase":"completed","message":"自动资产阶段已完成，报告已返回。","auto_asset_status_counts":{}}},"widgets_values":[5],"color":"#234","bgcolor":"#345"},{"id":10,"type":"CompanyLongVideoContinuityPreview","pos":[3200,0],"size":[510,1030.65625],"flags":{},"order":5,"mode":0,"inputs":[{"localized_name":"job","name":"job","type":"长视频分段任务","link":14}],"outputs":[{"localized_name":"可合并任务","name":"可合并任务","type":"长视频分段任务","links":[11]},{"localized_name":"连续性检查 JSON","name":"连续性检查 JSON","type":"STRING","links":[]},{"localized_name":"各段末帧","name":"各段末帧","type":"IMAGE","links":[10]}],"title":"6. 检查当前批次结果，满意后再继续","properties":{"Node name for S&R":"CompanyLongVideoContinuityPreview"},"widgets_values":[],"color":"#234","bgcolor":"#345"},{"id":11,"type":"CompanyFixedColumnImagePreview","pos":[3200,540],"size":[650,558],"flags":{},"order":7,"mode":0,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":10},{"localized_name":"columns","name":"columns","type":"COMBO","widget":{"name":"columns"},"link":null},{"localized_name":"gap","name":"gap","type":"INT","widget":{"name":"gap"},"link":null}],"outputs":[{"localized_name":"原始图片","name":"原始图片","type":"IMAGE","links":[]}],"title":"预览：每段生成视频的末帧","properties":{"Node name for S&R":"CompanyFixedColumnImagePreview","last_fixed_grid_images":[{"filename":"ComfyUI_temp_jsfdl_00001_.png","subfolder":"","type":"temp"},{"filename":"ComfyUI_temp_jsfdl_00002_.png","subfolder":"","type":"temp"},{"filename":"ComfyUI_temp_jsfdl_00003_.png","subfolder":"","type":"temp"},{"filename":"ComfyUI_temp_jsfdl_00004_.png","subfolder":"","type":"temp"},{"filename":"ComfyUI_temp_jsfdl_00005_.png","subfolder":"","type":"temp"}]},"widgets_values":["3",8,""],"color":"#234","bgcolor":"#345"},{"id":12,"type":"CompanyLongVideoManualBatchFinalizerV1","pos":[4050,0],"size":[510,350],"flags":{},"order":6,"mode":0,"inputs":[{"localized_name":"job","name":"job","type":"长视频分段任务","link":11},{"localized_name":"series_state_json","name":"series_state_json","type":"STRING","widget":{"name":"series_state_json"},"link":13}],"outputs":[{"localized_name":"当前批次视频","name":"当前批次视频","type":"VIDEO","links":[12]},{"localized_name":"当前批次视频路径","name":"当前批次视频路径","type":"STRING","links":[]},{"localized_name":"已提交系列状态 JSON","name":"已提交系列状态 JSON","type":"STRING","links":[]},{"localized_name":"人工审阅状态 JSON","name":"人工审阅状态 JSON","type":"STRING","links":[]}],"title":"7. 合并并提交当前批次，然后暂停审阅","properties":{"Node name for S&R":"CompanyLongVideoManualBatchFinalizerV1"},"widgets_values":[""],"color":"#234","bgcolor":"#345"},{"id":13,"type":"SaveVideo","pos":[4800,0],"size":[319.890625,664.125],"flags":{},"order":8,"mode":0,"inputs":[{"localized_name":"视频","name":"video","type":"VIDEO","link":12},{"localized_name":"文件名前缀","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null},{"localized_name":"格式","name":"format","type":"COMBO","widget":{"name":"format"},"link":null},{"localized_name":"编码器","name":"codec","type":"COMBO","widget":{"name":"codec"},"link":null}],"outputs":[{"localized_name":"video","name":"video","type":"VIDEO","links":[]}],"title":"保存当前已审阅批次（满意后再运行下一批）","properties":{},"widgets_values":["video/LongVideoAnimeAutoShotAssets_Seedance","auto","auto"]},{"id":14,"type":"MarkdownNote","pos":[0,-1050],"size":[1300,760],"flags":{},"order":9,"mode":0,"inputs":[],"outputs":[],"title":"工作流总览｜推荐的 v3 手动批次生产入口","properties":{},"widgets_values":["# 工作流用途\n\n面向长视频生产，每次只处理一个约 0.5–5 分钟批次，完成后暂停，让操作人员检查后再继续下一批。\n\n## 整体思路\n\n`检测镜头 → 选择当前批次 → 建立 contract=4 任务 → 完成整帧转绘与质量筛选 → Seedance 顺序生成 → 人工检查 → 合并并提交批次 → 保存`\n\n## 关键原则\n\n- 原视频时间线决定批次游标，远端结果多几秒或少几秒不会改变下一批起点。\n- 只有通过身份、风格、构图与场景质量门槛的整帧才会进入 Seedance。\n- 不同逻辑镜头不传上一段末帧；只有同一逻辑镜头因模型时长上限拆分时才续接。\n- 本文件是生产优先入口，但仍应先用小范围测试工作流验收配置。"],"color":"#30485f","bgcolor":"#3f607d"},{"id":15,"type":"MarkdownNote","pos":[1400,-1050],"size":[1300,760],"flags":{},"order":10,"mode":0,"inputs":[],"outputs":[],"title":"节点作用｜检测、批次范围与任务规划","properties":{},"widgets_values":["# 节点 1–4\n\n1. **输入长视频**：选择完整源视频。\n2. **检测镜头与转场**：本地生成逻辑镜头计划。\n3. **控制本次生成批次**：首次新建系列；之后沿用系列状态继续或重试。`start_minute/end_minute` 都为 0 时按系列游标推进，填写区间时以绝对分钟范围覆盖游标。\n4. **建立当前批次资产任务**：保存提示词、模型、目标资源类型、音频策略、身份映射和断点恢复参数，生成 contract=4 manifest。\n\n当前保存值中 `use_original_audio=true`：视频生成阶段不以生成音频为目标，最终批次使用原视频音频。交付后仍应按项目需求复核该开关。"],"color":"#4b416d","bgcolor":"#62568b"},{"id":16,"type":"MarkdownNote","pos":[2800,-1050],"size":[1300,760],"flags":{},"order":11,"mode":0,"inputs":[],"outputs":[],"title":"节点作用｜资产与视频流水线（付费阶段）","properties":{},"widgets_values":["# 节点 5\n\n**实时预览整帧转绘，筛选后生成 Seedance** 是组合流水线节点：\n\n1. 按逻辑镜头提取并分析首/中/尾帧。\n2. 复用或生成目标人物、场景和整帧参考。\n3. 对身份、目标风格强度、原风格残留、构图与人物数量做质量门控。\n4. 全批图片完成后进行强弱比较，只把合格整帧打包。\n5. 再按逻辑顺序调用 Seedance 生成当前批次视频。\n\n`image_concurrency` 只控制图片阶段并发，不代表 Seedance 视频并行。该节点会调用远端文本、图片和视频服务，是本流程的主要付费节点；确认范围、提示词、身份映射和音频开关后再运行。"],"color":"#4b416d","bgcolor":"#62568b"},{"id":17,"type":"MarkdownNote","pos":[4200,-1050],"size":[1350,760],"flags":{},"order":12,"mode":0,"inputs":[],"outputs":[],"title":"节点作用｜审阅、提交与下一批","properties":{},"widgets_values":["# 节点 10–13\n\n10. **检查当前批次结果**：逐段播放并输出连续性报告和末帧；这是人工放行点。\n11. **末帧预览**：集中比较每段结尾，检查人物身份、服装、场景和动作方向。\n12. **合并并提交当前批次**：合并本批结果、写入系列状态，然后暂停等待人工审阅。\n13. **保存当前已审阅批次**：输出本批视频；满意后才运行下一批。\n\n## 操作纪律\n\n- 不满意时保持同一系列和源范围重试，不要误建新系列。\n- 满意并提交后，再继续下一批；不要跳过节点 10 的人工检查。\n- 后端重启后可依靠 manifest 和系列状态断点恢复，但仍需核对当前批次范围。"],"color":"#6b4f31","bgcolor":"#876640"}],"links":[[1,1,0,2,0,"VIDEO"],[2,2,0,3,0,"长视频镜头计划"],[3,3,0,4,0,"长视频镜头计划"],[4,4,0,5,0,"长视频分段任务"],[10,10,2,11,0,"IMAGE"],[11,10,0,12,0,"长视频分段任务"],[12,12,0,13,0,"VIDEO"],[13,3,3,12,1,"STRING"],[14,5,0,10,0,"长视频分段任务"]],"groups":[{"id":1,"title":"A. 检测并控制当前批次","bounding":[-60,140,1780,760],"color":"#3f789e","flags":{}},{"id":2,"title":"B. 资产与 Seedance 流水线（资源就绪即生成视频）","bounding":[1740,-140,1420,860],"color":"#81683e","flags":{}},{"id":4,"title":"C. 检查当前批次结果","bounding":[3180,-120,840,1180],"color":"#6b5b95","flags":{}},{"id":5,"title":"D. 当前批次提交后暂停，人工检查后继续","bounding":[4040,-120,1400,900],"color":"#8a6d3b","flags":{}}],"config":{},"extra":{"workflow_note":"实时预览版：先为当前批次生成完整画面的目标风格转绘，并自动淘汰转换太弱或构图失真的结果；同一场景和强风格参考会复用。全部镜头完成质量比较后，只把合格整帧按时间范围交给 Seedance。不同场景不传上一组末帧，保留结果检查、合并和每批人工审阅。","long_video":{"auto_shot_assets":true,"remote_video_requests":true,"manifest_version":4,"video_engine":"seedance","video_model":"Seedance 2.0 Fast","visual_style":"anime_2d","send_source_video":false,"range_limit":{"enabled":true,"default_mode":"按分钟","default_minutes":2,"whole_shot_policy":true},"selectable_visual_styles":["western","photoreal","anime_2d","cg_3d","comic_illustration","custom"],"processing_contract_version":4,"short_shot_grouping":"adjacent-short-shots-v1","reference_package_version":"integrated-frames-v2","use_original_audio_default":false,"preserve_generated_video_content":true,"manual_batch":true,"pause_after_each_batch":true,"batch_contract":"seedance_v3_manual_batch_v1","default_batch_minutes":1,"batch_minutes_range":[0.5,5],"boundary_tolerance_seconds":10,"source_cursor_rule":"source_timeline_authoritative","cross_batch_reference_role":"cross_batch_final_frame","asset_video_pipeline":true,"asset_video_overlap":false,"global_integrated_frame_calibration":true,"pipeline_video_order":"sequential_with_same_logical_shot_continuity_only","pipeline_asset_order":"logical_member_order","intermediate_reference_review":false},"ds":{"scale":0.4598912856689836,"offset":[452.74648072683607,807.6660786965726]},"company_remote_handover_notes":{"version":1,"language":"zh-CN","node_type":"MarkdownNote","execution_impact":false}},"version":0.4}