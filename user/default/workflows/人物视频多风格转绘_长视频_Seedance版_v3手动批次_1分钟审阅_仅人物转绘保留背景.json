json"},"link":13}],"outputs":[{"localized_name":"当前批次视频","name":"当前批次视频","type":"VIDEO","links":[12]},{"localized_name":"当前批次视频路径","name":"当前批次视频路径","type":"STRING","links":[]},{"localized_name":"已提交系列状态 JSON","name":"已提交系列状态 JSON","type":"STRING","links":[]},{"localized_name":"人工审阅状态 JSON","name":"人工审阅状态 JSON","type":"STRING","links":[]}],"title":"9. 合并并提交当前批次，然后暂停审阅","properties":{"Node name for S&R":"CompanyLongVideoManualBatchFinalizerV1"},"widgets_values":[""],"color":"#234","bgcolor":"#345"},{"id":13,"type":"SaveVideo","pos":[7455.673701916808,-21.631490415974824],"size":[319.890625,664.125],"flags":{},"order":12,"mode":0,"inputs":[{"localized_name":"视频","name":"video","type":"VIDEO","link":12},{"localized_name":"文件名前缀","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null},{"localized_name":"格式","name":"format","type":"COMBO","widget":{"name":"format"},"link":null},{"localized_name":"编码器","name":"codec","type":"COMBO","widget":{"name":"codec"},"link":null}],"outputs":[{"localized_name":"video","name":"video","type":"VIDEO","links":null}],"title":"保存当前已审阅批次（满意后再运行下一批）","properties":{},"widgets_values":["video/LongVideoPersonOnlyRestyle_Seedance","auto","auto"]},{"id":14,"type":"CompanyLongVideoAssetLibraryViewer","pos":[2487.069504957754,786.7622363159269],"size":[520,600],"flags":{},"order":13,"mode":0,"inputs":[{"localized_name":"job","name":"job","shape":7,"type":"长视频分段任务","link":14},{"localized_name":"visual_style","name":"visual_style","type":"COMBO","widget":{"name":"visual_style"},"link":null},{"localized_name":"columns","name":"columns","type":"COMBO","widget":{"name":"columns"},"link":null}],"outputs":[{"localized_name":"入库资源预览","name":"入库资源预览","type":"IMAGE","links":[]},{"localized_name":"入库资源清单 JSON","name":"入库资源清单 JSON","type":"STRING","links":[]},{"localized_name":"汇总","name":"汇总","type":"STRING","links":[]}],"title":"查看入库素材库资源（缩略图 + 火山 asset_id + 状态）","properties":{"Node name for S&R":"CompanyLongVideoAssetLibraryViewer"},"widgets_values":["欧美化资源","3"],"color":"#234","bgcolor":"#345"},{"id":15,"type":"MarkdownNote","pos":[-100,-1250],"size":[1450,840],"flags":{},"order":14,"mode":0,"inputs":[],"outputs":[],"title":"工作流总览｜只转绘人物，原视频背景必须保持不变","properties":{},"widgets_values":["# 与整帧欧美化版的区别\n\n本流程只替换/重设计人物，**背景、环境、建筑、家具、道具、天空、地面、光线方向、色调和摄影质感必须保持原视频不变**。\n\n## 整体思路\n\n`检测镜头 → 选择批次 → 建立 person_only 任务 → 生成人物母版与“人物已替换、背景保留”的整帧参考 → 质量筛选 → Seedance 生成 → 人工核对背景 → 合并并提交`\n\n- 不生成场景母版。\n- 强制使用整帧参考来携带原背景。\n- 人物素材库仍可复用欧美化人物资源。\n- 适合业务只允许改人物、不允许重绘场景的素材。"],"color":"#30485f","bgcolor":"#3f607d"},{"id":16,"type":"MarkdownNote","pos":[1450,-1250],"size":[1500,840],"flags":{},"order":15,"mode":0,"inputs":[],"outputs":[],"title":"节点作用｜范围、人物任务与关键开关","properties":{},"widgets_values":["# 节点 1–4\n\n1. **输入长视频**：选择完整源片。\n2. **检测镜头与转场**：生成逻辑镜头计划。\n3. **控制当前批次**：管理系列、游标或绝对分钟区间。\n4. **人物转绘规划器**：建立 `restyle_scope=person_only` 的 contract=4 任务。\n\n当前示例范围是 `start_minute=1`、`end_minute=1.5`，即第 60–90 秒；交付后必须改为目标范围，或都设为 0 按系列游标推进。\n\n节点 4 保存的关键设置：\n- `use_integrated_frame_references=true`：必须用整帧携带原背景；\n- `use_original_audio=false`：默认保留 Seedance 生成内容与音频；\n- 目标资源为“欧美化资源”。"],"color":"#4b416d","bgcolor":"#62568b"},{"id":17,"type":"MarkdownNote","pos":[3050,-1250],"size":[1650,840],"flags":{},"order":16,"mode":0,"inputs":[],"outputs":[],"title":"节点作用｜人物资产、背景核对与素材库","properties":{},"widgets_values":["# 节点 5–8、14\n\n5. **仅人物转绘整帧**：生成/复用人物母版，把人物放回原背景整帧，并自动淘汰人物转换过弱、身份不稳或背景被改动的结果；会调用远端文本/图片服务。\n6. **整帧对照预览**：重点比较背景物体、构图、光线、色调是否与原帧一致。\n7. **参考打包**：只打包合格人物母版和背景保持正确的整帧参考。\n8. **Seedance 参考预览**：确认人物身份、图片顺序和原背景均正确。\n14. **素材库查看**：只读显示人物资源和 `asset_id`；节点本身不收费。\n\n如果背景发生重绘、调色、物体增删或明显跳变，即使人物效果良好也应判定不通过。"],"color":"#4b416d","bgcolor":"#62568b"},{"id":18,"type":"MarkdownNote","pos":[4800,-1250],"size":[1850,840],"flags":{},"order":17,"mode":0,"inputs":[],"outputs":[],"title":"节点作用｜视频生成、审阅与提交","properties":{},"widgets_values":["# 节点 9–13\n\n9. **Seedance 生成当前批次**：按已筛选参考顺序生成，仅同一逻辑镜头拆分时续接；属于付费视频阶段。\n10. **连续性检查**：逐段播放并输出末帧。\n11. **末帧网格**：检查人物身份和原背景是否跨段稳定。\n12. **合并并提交批次**：更新系列状态并暂停人工审阅。\n13. **保存当前批次**：输出已审阅结果。\n\n## 本流程额外验收项\n\n除人物身份、数量、肢体和连续性外，必须逐镜头确认：背景没有风格化、没有重绘、没有新增/删除物体，光线方向和摄影质感未改变。失败时保持同一系列和源范围重试，不要继续下一批。"],"color":"#6b4f31","bgcolor":"#876640"}],"links":[[1,1,0,2,0,"VIDEO"],[2,2,0,3,0,"长视频镜头计划"],[3,3,0,4,0,"长视频镜头计划"],[4,4,0,5,0,"长视频分段任务"],[5,5,2,6,0,"IMAGE"],[6,5,0,7,0,"长视频分段任务"],[7,7,2,8,0,"IMAGE"],[8,7,0,9,0,"长视频分段任务"],[9,9,0,10,0,"长视频分段任务"],[10,10,2,11,0,"IMAGE"],[11,10,0,12,0,"长视频分段任务"],[12,12,0,13,0,"VIDEO"],[13,3,3,12,1,"STRING"],[14,5,0,14,0,"长视频分段任务"]],"groups":[{"id":1,"title":"A. 检测并控制当前批次","bounding":[-133.5470674143146,-126.78838179702308,1800,760],"color":"#3f789e","flags":{}},{"id":2,"title":"B. 自动生成并检查目标人物资产（背景保留原视频）","bounding":[1718.68900058085,-121.6460081319001,2140,780],"color":"#81683e","flags":{}},{"id":3,"title":"C. 打包并检查 Seedance 人物转绘参考图","bounding":[3892.789503194674,-125.95778849916994,1440,700],"color":"#4f7f69","flags":{}},{"id":4,"title":"D. 顺序生成、检查、合并与保存","bounding":[5395.673701916808,-121.631490415975,2600,1100],"color":"#6b5b95","flags":{}},{"id":5,"title":"E. 当前批次提交后暂停，人工检查后继续","bounding":[6600,-120,1700,900],"color":"#8a6d3b","flags":{}},{"id":6,"title":"F. 查看已入库素材库资源（只读，不产生费用）","bounding":[2446.8303069737717,698.5696029113928,600,700],"color":"#6b5b95","flags":{}}],"config":{},"extra":{"workflow_note":"手动批次审阅版（仅人物转绘）：每次只生成一个约 1 分钟批次，完成后暂停等待人工检查。与整帧转绘版的区别：只把人物替换为目标风格，背景保持原视频画面；不生成场景母版，整帧参考图强制开启并携带原背景。继续下一批按原视频时间线推进，上一批已提交的最终帧只注入下一批第一个 Seedance 请求。重试当前批保持同一源范围和批次编号。","long_video":{"auto_shot_assets":true,"remote_video_requests":true,"manifest_version":4,"video_engine":"seedance","video_model":"Seedance 2.0 Fast","visual_style":"western","send_source_video":false,"range_limit":{"enabled":true,"default_mode":"按分钟","default_minutes":2,"whole_shot_policy":true},"selectable_visual_styles":["western","photoreal","anime_2d","cg_3d","comic_illustration","custom"],"processing_contract_version":4,"short_shot_grouping":"adjacent-short-shots-v1","reference_packag