ty","name":"image_quality","type":"COMBO","widget":{"name":"image_quality"},"link":null},{"localized_name":"reuse_threshold","name":"reuse_threshold","type":"FLOAT","widget":{"name":"reuse_threshold"},"link":null},{"localized_name":"max_retries","name":"max_retries","type":"INT","widget":{"name":"max_retries"},"link":null},{"localized_name":"resume","name":"resume","type":"BOOLEAN","widget":{"name":"resume"},"link":null},{"localized_name":"force_rerun","name":"force_rerun","type":"BOOLEAN","widget":{"name":"force_rerun"},"link":null},{"localized_name":"force_rerun_assets","name":"force_rerun_assets","type":"BOOLEAN","widget":{"name":"force_rerun_assets"},"link":null},{"localized_name":"image_provider","name":"image_provider","type":"COMBO","widget":{"name":"image_provider"},"link":null},{"localized_name":"negative_prompt","name":"negative_prompt","shape":7,"type":"STRING","widget":{"name":"negative_prompt"},"link":null},{"localized_name":"target_resource_type","name":"target_resource_type","shape":7,"type":"COMBO","widget":{"name":"target_resource_type"},"link":null},{"localized_name":"use_original_audio","name":"use_original_audio","shape":7,"type":"BOOLEAN","widget":{"name":"use_original_audio"},"link":null},{"localized_name":"use_integrated_frame_references","name":"use_integrated_frame_references","shape":7,"type":"BOOLEAN","widget":{"name":"use_integrated_frame_references"},"link":null},{"localized_name":"identity_mapping_json","name":"identity_mapping_json","shape":7,"type":"STRING","widget":{"name":"identity_mapping_json"},"link":null}],"outputs":[{"localized_name":"多风格长视频任务","name":"多风格长视频任务","type":"长视频分段任务","links":[4]},{"localized_name":"任务计划 JSON","name":"任务计划 JSON","type":"STRING","links":[]},{"localized_name":"任务 manifest 路径","name":"任务 manifest 路径","type":"STRING","links":[]}],"title":"4. 建立当前批次人物转绘任务（保留背景，contract=4）","properties":{"Node name for S&R":"CompanyLongVideoManualBatchPersonOnlyPlannerV1"},"widgets_values":["只把本段原视频中的人物替换为参考图片中的欧美人物，背景保持原视频画面完全不变。人物参考图是替换后人物身份、脸、发型、服装、配饰和整体造型的唯一视觉依据；人物必须整体重设计为符合当代欧美审美的外国人物，而不是只更换面孔。整帧参考图展示了『人物已替换、背景保持原视频』的最终画面标准，输出的每一帧都必须符合这一标准。背景、环境、建筑、家具、道具、天空、地面、光线方向、色调和摄影质感必须与原视频保持一致，不得风格化背景、不得重绘环境、不得改变背景中的任何物体。严格保持实际人物数量、人物关系、主要剧情顺序、镜头构图和场景功能，替换后的人物与原背景自然融合，从第一帧到最后一帧保持人物身份、整体造型和背景稳定一致。","Seedance 2.0 Fast","gpt-5.6-sol","gpt-image-2","low",0.85,2,true,false,false,"WisArt","只换脸，亚洲面孔残留，原人物残留，原服装残留，背景被重绘，背景风格化，背景变化，环境改变，建筑改变，家具改变，道具改变，背景调色，光线方向改变，背景跳变，人物与背景光影不匹配，人物悬浮，人物复制，身份变化，多余人物，肢体畸形，额外手指，字幕，文字，Logo，水印","欧美化资源",false,true,""],"color":"#234","bgcolor":"#345"},{"id":5,"type":"CompanyLongVideoAutoAssetBuilder","pos":[2451.7217425289346,-32.407905641387785],"size":[600,620],"flags":{},"order":4,"mode":0,"inputs":[{"localized_name":"job","name":"job","type":"长视频分段任务","link":4},{"localized_name":"image_concurrency","name":"image_concurrency","type":"INT","widget":{"name":"image_concurrency"},"link":null}],"outputs":[{"localized_name":"已生成镜头资产的任务","name":"已生成镜头资产的任务","type":"长视频分段任务","links":[6,14]},{"localized_name":"镜头资产报告 JSON","name":"镜头资产报告 JSON","type":"STRING","links":[]},{"localized_name":"源帧、复用素材与可选整帧预览","name":"源帧、复用素材与可选整帧预览","type":"IMAGE","links":[5]}],"title":"5. 仅人物转绘整帧并自动淘汰弱转换（背景保留）","properties":{"Node name for S&R":"CompanyLongVideoAutoAssetBuilder","last_auto_asset_progress":{"job_id":"b5a06c0e28802a50ac3a","percent":100,"value":14,"total":14,"phase":"completed","message":"自动资产阶段已完成，报告已返回。","auto_asset_status_counts":{"masters_ready":11,"failed":3}}},"widgets_values":[5,""],"color":"#234","bgcolor":"#345"},{"id":6,"type":"CompanyFixedColumnImagePreview","pos":[3106.002969617973,-17.449402268886274],"size":[760,2815.390625],"flags":{},"order":5,"mode":0,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":5},{"localized_name":"columns","name":"columns","type":"COMBO","widget":{"name":"columns"},"link":null},{"localized_name":"gap","name":"gap","type":"INT","widget":{"name":"gap"},"link":null}],"outputs":[{"localized_name":"原始图片","name":"原始图片","ty